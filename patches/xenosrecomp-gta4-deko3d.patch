+static constexpr const char* kDeko3dTextureMarker = "//@GTA4_DK_TEXTURES@\n";
+
+void ShaderRecompiler::printDeko3dConstants(const ConstantTableContainer* constantTableContainer,
+                                            const std::unordered_set<uint32_t>& referencedSlots)
+{
+    std::unordered_set<uint32_t> slots;
+    for (uint32_t i = 0; i < constantTableContainer->constantTable.constants; i++)
+    {
+        const auto constantInfo = reinterpret_cast<const ConstantInfo*>(
+            constantTableData + constantTableContainer->constantTable.constantInfo + i * sizeof(ConstantInfo));
+        const char* constantName = reinterpret_cast<const char*>(constantTableData + constantInfo->name);
+
+        switch (constantInfo->registerSet)
+        {
+        case RegisterSet::Float4:
+        {
+            const char* arrayName = isPixelShader ? "g_DkPixelConstants" : "g_DkVertexConstants";
+            if (constantInfo->registerCount > 1)
+            {
+                uint32_t tailCount = (isPixelShader ? 224 : 256) - constantInfo->registerIndex;
+                println("#define {}(INDEX) selectWrapper((INDEX) < {}, {}[{} + min(INDEX, {})], 0.0)",
+                    constantName, tailCount, arrayName, constantInfo->registerIndex.get(), tailCount - 1);
+            }
+            else
+            {
+                println("#define {} {}[{}]", constantName, arrayName, constantInfo->registerIndex.get());
+            }
+            break;
+        }
+        case RegisterSet::Sampler:
+        {
+            slots.insert(constantInfo->registerIndex);
+            for (size_t j = 0; j < std::size(TEXTURE_DIMENSIONS); j++)
+                println("#define {}_Texture{}DescriptorIndex g_DkTexture{}_{}", constantName, TEXTURE_DIMENSIONS[j],
+                    TEXTURE_DIMENSIONS[j], constantInfo->registerIndex.get());
+            println("#define {}_SamplerDescriptorIndex g_DkSampler_{}", constantName, constantInfo->registerIndex.get());
+            break;
+        }
+        default:
+            break;
+        }
+    }
+    for (uint32_t slot : referencedSlots)
+    {
+        if (slots.count(slot) || samplers.find(slot) != samplers.end())
+            continue;
+        for (size_t j = 0; j < std::size(TEXTURE_DIMENSIONS); j++)
+            println("#define s{}_Texture{}DescriptorIndex g_DkTexture{}_{}", slot, TEXTURE_DIMENSIONS[j],
+                TEXTURE_DIMENSIONS[j], slot);
+        println("#define s{}_SamplerDescriptorIndex g_DkSampler_{}", slot, slot);
+    }
+    out += kDeko3dTextureMarker;
+}
+
+void ShaderRecompiler::finishDeko3dTextures()
+{
+    const size_t at = out.find(kDeko3dTextureMarker);
+    if (at == std::string::npos)
+        return;
+    std::string declarations;
+    for (const auto& [slot, dimensions] : deko3dTextureDimensions)
+    {
+        if (slot >= 32 || (dimensions & (dimensions - 1)) != 0)
+        {
+            // deko3d has 32 texture bindings per stage, one type each: a slot sampled with two
+            // dimensions has no fixed binding. Fail the deko3d compile with the reason.
+            declarations += fmt::format("#error \"GTA4_DEKO3D: fetch slot {} sampled as dimensions mask {}\"\n",
+                slot, dimensions);
+            continue;
+        }
+        for (size_t j = 0; j < std::size(TEXTURE_DIMENSIONS); j++)
+        {
+            if (dimensions & (1u << j))
+                declarations += fmt::format("[[vk::binding({0}, 0)]] Texture{1}<float4> g_DkTexture{1}_{0};\n",
+                    slot, TEXTURE_DIMENSIONS[j]);
+        }
+        declarations += fmt::format("[[vk::binding({0}, 1)]] SamplerState g_DkSampler_{0};\n", slot);
+    }
+    out.replace(at, std::char_traits<char>::length(kDeko3dTextureMarker), declarations);
+}
